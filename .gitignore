# Generic build output
build/

# Log/OS Files
*.log

# JetBrains IDEs
*.iml
.idea/

# Xcode
xcuserdata/
*.xcscmblueprint
*.xccheckout
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# iOS
*.ipa
*.dSYM.zip
*.dSYM

# CocoaPods
Pods/
Podfile.lock

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# macOS
.DS_Store

# Environment and secrets
.env
.env.*

# App Store Connect API keys
fastlane/.env
fastlane/appstore-keys/

# [CC]
.claude/

# Temporary patches
deps/*.patch

# Alpine downloadable assets (ISO, rootfs, qcow2, etc.)
deps/alpine/

# iSH build outputs
deps/libs/
deps/include/
deps/resources/
deps/ish/build-ios/
deps/ish/build-native/
deps/.cache/

# FFmpeg source (downloaded by build_ffmpeg.sh). Note the trailing -6.1.2:
# a bare `deps/ffmpeg-*/` also swallowed deps/ffmpeg-patch/, which is hand
# written source that the build needs and must stay tracked.
deps/ffmpeg-6.1.2/

# FFmpeg framework build products (regenerated by deps/build_ffmpeg.sh).
deps/frameworks/

src-bak/

# Xcode debugger state (breakpoints) — personal dev state, never track
xcshareddata/xcdebugger/

# Build-time generated Swift (from ProviderCustomization.xcconfig); regenerated each build
src/ios/Generated/

# ── Build artifacts produced by deps/ scripts — never commit binaries ──
# These are generated, not authored: rebuild them from source instead of
# tracking them (tracked binaries also leak the build machine's paths via
# debug symbols). See deps/build_lame.sh, deps/prepare_alpine_rootfs.sh and
# BUILDING.md for the build order.
deps/lame-build/
deps/lame-3.100/**/.libs/

# LAME autotools output (./configure writes absolute build paths into these)
deps/lame-3.100/**/Makefile
deps/lame-3.100/config.status
deps/lame-3.100/config.h
deps/lame-3.100/libtool
deps/lame-3.100/**/stamp-h1
deps/lame-3.100/**/*.la
deps/lame-3.100/**/*.lai
deps/lame-3.100/**/.libs/
deps/lame-3.100/**/.deps/

# Local-only IPA builds and extracted payloads. The released IPA
# (dist/ipa/Minis_com.openminis.app.ipa) is tracked; these are not.
dist/ipa/Payload/
dist/ipa/*.zip
dist/ipa/Minis_com.minis.*.ipa
dist/ipa/Minis_com.openminis.app.1.*.ipa
dist/ipa/Minis_com.openminis.app.opencode-go.ipa

# OpenCode Go relay plugin source — kept local, not published.
/extensions/
