{
  "about": "Routing decision vectors for Settings > Network (spec: README.md section 3). Each case: the router config, the Tailscale node's state, one connection (tag, host) and the decision. kind: direct | tailscale | proxy. rule: route | tailnet | exit-node | bypass | missing-proxy. Checked against the Go router by deps/rclone-mobile/nethub/spec_vectors_test.go; every platform's router must produce the same.",
  "cases": [
    {"name": "unconfigured app: everything direct",
     "config": {"defaultRoute": "direct", "tags": {}, "upstreams": [], "tailscale": false},
     "node": {"running": false}, "tag": "default", "host": "api.openai.com",
     "want": {"kind": "direct", "rule": "route"}},
    {"name": "tailnet IP goes through Tailscale whatever the route",
     "config": {"defaultRoute": "direct", "tags": {}, "upstreams": [], "tailscale": true},
     "node": {"running": true, "prefixes": ["100.64.0.5/32"]}, "tag": "shell", "host": "100.64.0.5",
     "want": {"kind": "tailscale", "rule": "tailnet"}},
    {"name": "tailnet IP with a proxy route still goes through Tailscale",
     "config": {"defaultRoute": "proxy:p1", "tags": {}, "upstreams": [{"id": "p1"}], "tailscale": true},
     "node": {"running": true, "prefixes": ["100.64.0.5/32"]}, "tag": "default", "host": "100.64.0.5",
     "want": {"kind": "tailscale", "rule": "tailnet"}},
    {"name": "Tailscale enabled but the node is not running: tailnet IP falls back to the route",
     "config": {"defaultRoute": "direct", "tags": {}, "upstreams": [], "tailscale": true},
     "node": {"running": false, "prefixes": ["100.64.0.5/32"]}, "tag": "shell", "host": "100.64.0.5",
     "want": {"kind": "direct", "rule": "route"}},
    {"name": "node running but Tailscale off in settings: no tailnet split",
     "config": {"defaultRoute": "direct", "tags": {}, "upstreams": [], "tailscale": false},
     "node": {"running": true, "prefixes": ["100.64.0.5/32"]}, "tag": "shell", "host": "100.64.0.5",
     "want": {"kind": "direct", "rule": "route"}},
    {"name": "MagicDNS name goes through Tailscale",
     "config": {"defaultRoute": "direct", "tags": {}, "upstreams": [], "tailscale": true},
     "node": {"running": true, "magicDNSSuffix": "tail1234.ts.net"}, "tag": "backup", "host": "nas.tail1234.ts.net",
     "want": {"kind": "tailscale", "rule": "tailnet"}},
    {"name": "CGNAT address that is not in the node's table is NOT tailnet (no hard-coded 100.64.0.0/10)",
     "config": {"defaultRoute": "direct", "tags": {}, "upstreams": [], "tailscale": true},
     "node": {"running": true, "prefixes": ["100.64.0.5/32"]}, "tag": "shell", "host": "100.100.9.9",
     "want": {"kind": "direct", "rule": "route"}},
    {"name": "an exit node's 0/0 prefix does not make every address tailnet",
     "config": {"defaultRoute": "direct", "tags": {}, "upstreams": [], "tailscale": true},
     "node": {"running": true, "exitNode": true, "prefixes": ["0.0.0.0/0", "100.64.0.5/32"]}, "tag": "shell", "host": "8.8.8.8",
     "want": {"kind": "direct", "rule": "route"}},
    {"name": "subnet route (acceptRoutes) is tailnet",
     "config": {"defaultRoute": "direct", "tags": {}, "upstreams": [], "tailscale": true},
     "node": {"running": true, "prefixes": ["192.168.50.0/24"]}, "tag": "shell", "host": "192.168.50.10",
     "want": {"kind": "tailscale", "rule": "tailnet"}},
    {"name": "route tailscale without an exit node: internet traffic direct",
     "config": {"defaultRoute": "tailscale", "tags": {}, "upstreams": [], "tailscale": true},
     "node": {"running": true, "prefixes": []}, "tag": "default", "host": "example.com",
     "want": {"kind": "direct", "rule": "route"}},
    {"name": "route tailscale with an exit node: internet traffic through the exit node",
     "config": {"defaultRoute": "tailscale", "tags": {}, "upstreams": [], "tailscale": true},
     "node": {"running": true, "exitNode": true, "prefixes": []}, "tag": "default", "host": "example.com",
     "want": {"kind": "tailscale", "rule": "exit-node"}},
    {"name": "route direct ignores an active exit node",
     "config": {"defaultRoute": "direct", "tags": {}, "upstreams": [], "tailscale": true},
     "node": {"running": true, "exitNode": true, "prefixes": []}, "tag": "default", "host": "example.com",
     "want": {"kind": "direct", "rule": "route"}},
    {"name": "proxy route",
     "config": {"defaultRoute": "direct", "tags": {"prov:A": "proxy:p1"}, "upstreams": [{"id": "p1"}], "tailscale": false},
     "node": {"running": false}, "tag": "prov:A", "host": "api.anthropic.com",
     "want": {"kind": "proxy", "rule": "route"}},
    {"name": "a deleted proxy falls back to direct",
     "config": {"defaultRoute": "direct", "tags": {"backup": "proxy:gone"}, "upstreams": [], "tailscale": false},
     "node": {"running": false}, "tag": "backup", "host": "dav.example.com",
     "want": {"kind": "direct", "rule": "missing-proxy"}},
    {"name": "proxy bypass by suffix",
     "config": {"defaultRoute": "proxy:p1", "tags": {}, "upstreams": [{"id": "p1", "bypass": ["*.corp.example"]}], "tailscale": false},
     "node": {"running": false}, "tag": "default", "host": "git.corp.example",
     "want": {"kind": "direct", "rule": "bypass"}},
    {"name": "proxy bypass by CIDR",
     "config": {"defaultRoute": "proxy:p1", "tags": {}, "upstreams": [{"id": "p1", "bypass": ["10.0.0.0/8"]}], "tailscale": false},
     "node": {"running": false}, "tag": "default", "host": "10.1.2.3",
     "want": {"kind": "direct", "rule": "bypass"}},
    {"name": "loopback is always bypassed by a proxy",
     "config": {"defaultRoute": "proxy:p1", "tags": {}, "upstreams": [{"id": "p1"}], "tailscale": false},
     "node": {"running": false}, "tag": "default", "host": "localhost",
     "want": {"kind": "direct", "rule": "bypass"}},
    {"name": "a tag set to \"default\" follows the default route",
     "config": {"defaultRoute": "proxy:p1", "tags": {"mcp": "default"}, "upstreams": [{"id": "p1"}], "tailscale": false},
     "node": {"running": false}, "tag": "mcp", "host": "mcp.example.com",
     "want": {"kind": "proxy", "rule": "route"}},
    {"name": "an unknown tag follows the default route",
     "config": {"defaultRoute": "proxy:p1", "tags": {}, "upstreams": [{"id": "p1"}], "tailscale": false},
     "node": {"running": false}, "tag": "prov:NEW", "host": "api.example.com",
     "want": {"kind": "proxy", "rule": "route"}},
    {"name": "a tag's own direct route overrides a proxied default",
     "config": {"defaultRoute": "proxy:p1", "tags": {"shell": "direct"}, "upstreams": [{"id": "p1"}], "tailscale": false},
     "node": {"running": false}, "tag": "shell", "host": "dl-cdn.alpinelinux.org",
     "want": {"kind": "direct", "rule": "route"}}
  ]
}
